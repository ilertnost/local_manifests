<?xml version="1.0" encoding="UTF-8"?>
<!--
  Local manifest for the Xiaomi 15 (dada, SM8750) Evolution X 17 build.

  Apply on top of the Evolution X manifest (repo init -b cnb).  All
  device-specific repositories live under https://github.com/ilertnost; the
  remaining projects keep their upstream owners.
-->
<manifest>
  <remote name="ilertnost" fetch="https://github.com/ilertnost" />
  <remote name="xiaomi-dada" fetch="https://github.com/xiaomi-dada" revision="lineage-24.0" />

  <!-- Device tree, common tree and proprietary blobs -->
  <project path="device/xiaomi/dada" name="device_xiaomi_dada" remote="ilertnost" revision="lineage-24.0" />
  <project path="device/xiaomi/sm8750-common" name="device_xiaomi_sm8750-common" remote="ilertnost" revision="lineage-24.0" />
  <project path="vendor/xiaomi/dada" name="vendor_xiaomi_dada" remote="ilertnost" revision="lineage-24.0" />
  <project path="vendor/xiaomi/sm8750-common" name="vendor_xiaomi_sm8750-common" remote="ilertnost" revision="lineage-24.0" />

  <!--
      Kernel, built from source (CLO KERNEL.PLATFORM.4.0.r1-18500 with the
      LineageOS/Xiaomi changes).  lineage-24.0-oss is the Android 17 / GKI
      branch.
  -->
  <project path="kernel/xiaomi/sm8750" name="android_kernel_qcom_sm8750" remote="ilertnost" revision="lineage-24.0-oss" />
  <project path="kernel/xiaomi/sm8750-devicetrees" name="android_kernel_xiaomi_sm8750-devicetrees" remote="ilertnost" revision="lineage-24.0" />
  <project path="kernel/xiaomi/sm8750-modules" name="android_kernel_xiaomi_sm8750-modules" remote="ilertnost" revision="lineage-24.0" />

  <!--
      Not in the upstream manifest: the ultrasonic fingerprint, MiSys camera
      and IR HALs on top of the stock AOSP/Lineage hardware/xiaomi.
  -->
  <project path="hardware/xiaomi" name="android_hardware_xiaomi" remote="ilertnost" revision="lineage-24.0" />

  <!--
      Display stack.  The sm8750 CAF display hal is replaced by the fork with
      getDisplayAttributes indexed like getConfigCount, the xiaomi_rgb_notifier
      hook and panels reporting their size in tenths of a millimetre.
      The CAF copies of display/core and display/intf are dropped: the same
      modules come from the open-source sdm/sde-drm and display-intf projects.
  -->
  <remove-project name="LineageOS/android_hardware_qcom_display"
                  path="hardware/qcom-caf/sm8750/display/hal" />
  <remove-project name="LineageOS/android_vendor_qcom_opensource_display-core"
                  path="hardware/qcom-caf/sm8750/display/core" />
  <remove-project name="LineageOS/android_vendor_qcom_opensource_display-intf"
                  path="hardware/qcom-caf/sm8750/display/intf" />

  <project path="hardware/qcom-caf/sm8750/display/hal"
           name="android_hardware_qcom_display"
           remote="ilertnost"
           revision="lineage-24.0-caf-sm8750" />
  <project path="vendor/qcom/opensource/display-core"
           name="android_vendor_qcom_opensource_display-core"
           remote="ilertnost"
           revision="lineage-24.0-caf-sm8750" />
  <project path="vendor/qcom/opensource/display-intf"
           name="android_vendor_qcom_opensource_display-intf"
           remote="ilertnost"
           revision="lineage-24.0-caf-sm8750" />

  <!--
      Camera fixes: let the Xiaomi camera use the vendor sizes of its
      implementation defined streams (frameworks/av), and don't protect the
      client target for protected camera layers (frameworks/native).
  -->
  <remove-project name="frameworks_av" path="frameworks/av" />
  <project path="frameworks/av"
           name="android_frameworks_av"
           remote="ilertnost"
           revision="cnb"
           groups="pdk,sysui-studio" />

  <remove-project name="frameworks_native" path="frameworks/native" />
  <project path="frameworks/native"
           name="android_frameworks_native"
           remote="ilertnost"
           revision="cnb"
           groups="pdk,sysui-studio" />

  <!--
      Trusted VM (qcrosvm): crosvm, rutabaga_gfx and the Virtualization apex,
      made available to the platform, plus Qualcomm's launcher.
  -->
  <remove-project name="platform/external/crosvm" path="external/crosvm" />
  <remove-project name="platform/external/rust/rutabaga_gfx" path="external/rust/rutabaga_gfx" />
  <remove-project name="platform/packages/modules/Virtualization" path="packages/modules/Virtualization" />

  <project path="external/crosvm"
           name="android_external_crosvm"
           remote="ilertnost"
           revision="cnb"
           groups="pdk" />
  <project path="external/rust/rutabaga_gfx"
           name="android_external_rust_rutabaga_gfx"
           remote="ilertnost"
           revision="lineage-24.0"
           groups="pdk" />
  <project path="packages/modules/Virtualization"
           name="android_packages_modules_Virtualization"
           remote="ilertnost"
           revision="lineage-24.0"
           groups="pdk" />
  <project path="vendor/qcom/opensource/crosvm-gunyah"
           name="android_vendor_qcom_opensource_crosvm-gunyah"
           remote="xiaomi-dada" />

  <!-- Dolby Atmos (HyperOS 4 dada ODM tuning & Xiaomi prebuilt AIDL ABI) -->
  <project path="hardware/dolby"
           name="android_hardware_dolby"
           remote="ilertnost"
           revision="lineage-24.0" />

  <!-- Bluetooth stack with QTI aptX Adaptive offload and LE Audio HAL fixes -->
  <remove-project name="packages_modules_Bluetooth" path="packages/modules/Bluetooth" />
  <project path="packages/modules/Bluetooth"
           name="android_packages_modules_Bluetooth"
           remote="ilertnost"
           revision="cnb"
           groups="pdk" />
</manifest>
